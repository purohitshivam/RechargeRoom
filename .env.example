# ==============================================================================
# Recharge Room Environment Configuration Template
# ==============================================================================

# Public Site URL (Used for canonical URLs, Open Graph, and calendar invites)
# Example: https://rechargeroom.co.in or http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase / PostgreSQL Database Configuration (Production Persistence)
# ------------------------------------------------------------------------------
# In local development, if Supabase is not configured, the app automatically
# falls back to a persistent atomic local store with identical concurrency guarantees.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# Owner Admin Authentication
# ------------------------------------------------------------------------------
# Password used by the founders to access the protected /admin dashboard
ADMIN_PASSWORD=change_this_to_a_strong_password
# 32+ character random secret used to sign session cookies
ADMIN_SESSION_SECRET=super_secret_session_key_min_32_characters_long

# ------------------------------------------------------------------------------
# Google Sheets Integration (Operational Booking Log)
# ------------------------------------------------------------------------------
# Google Cloud Service Account credentials with Google Sheets API enabled.
# The target spreadsheet MUST be shared with this service account email with 'Editor' permissions.
GOOGLE_SERVICE_ACCOUNT_EMAIL=recharge-room-sync@your-gcp-project.iam.gserviceaccount.com
# Format: Private key including "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Found in the spreadsheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
